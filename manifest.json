{
  "manifest_version": 3,
  "name": "Fund Lens",
  "version": "0.1.0",
  "description": "Combines your myCAMS and KFintech mutual fund portfolios. Reads only the pages you are logged in to; all data stays in your browser.",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://mfs.kfintech.com/*", "https://newmycams.camsonline.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content-main.js", "src/core/*.js", "src/adapters/*.js"],
      "matches": ["https://mfs.kfintech.com/*", "https://newmycams.camsonline.com/*"]
    }
  ],
  "action": { "default_title": "Fund Lens", "default_popup": "src/popup/popup.html" }
}
